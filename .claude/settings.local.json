{
  "permissions": {
    "allow": [
      "Bash(./gradlew :composeApp:assembleDebug)",
      "Bash(curl -s \"https://repo.maven.apache.org/maven2/io/mavsdk/mavsdk/maven-metadata.xml\")",
      "Bash(curl -s \"https://repo.maven.apache.org/maven2/io/mavsdk/mavsdk/3.16.0/mavsdk-3.16.0.pom\")",
      "Bash(./gradlew :composeApp:assembleDebug --no-configuration-cache)",
      "Bash(jar tf:*)",
      "Bash(javap:*)",
      "Bash(grep \"\\\\.class$\")",
      "Bash(./gradlew :composeApp:testDebugUnitTest --no-configuration-cache)",
      "Bash(grep \"io/mavsdk/camera/Camera.class\\\\|io/mavsdk/camera/Camera\\\\$\")",
      "Read(//private/tmp/**)",
      "Bash(jar xf:*)",
      "Bash(wait)",
      "Bash(./gradlew :composeApp:compileDebugKotlinAndroid)",
      "Bash(echo \"EXIT: $?\")",
      "Bash(./gradlew ktlintCheck)",
      "Bash(./gradlew :composeApp:jvmTest)",
      "Bash(./gradlew :composeApp:compileKotlinJvm)",
      "Bash(./gradlew :composeApp:jvmTest --no-daemon)",
      "Bash(tee /tmp/jvmtest.log)",
      "Read(//tmp/**)",
      "Bash(echo \"EXIT\")",
      "Bash(./gradlew :composeApp:compileKotlinJvm :composeApp:compileTestKotlinJvm)"
    ]
  }
}
